#!/usr/bin/env python3
"""Mutation check: break each security/merge rule in turn and confirm the suite goes red. Restores every file.
Usage: bin/mutation-check   (from anywhere; needs a clean, green baseline)"""
import os, signal, subprocess, pathlib
R = pathlib.Path(__file__).resolve().parent.parent
S = "src/review_desk/"
MUTANTS = [
 ("host check off", S+"server.py", 'if len(hosts) != 1 or hosts[0].strip() not in self._allowed_hosts():', 'if False:'),
 ("host allows any port", S+"server.py", 'return {f"127.0.0.1:{self.port}", f"localhost:{self.port}"}', 'return {f"127.0.0.1:{self.port}", f"localhost:{self.port}", "127.0.0.1", "127.0.0.1:1"}'),
 ("custom header off", S+"server.py", 'if self.headers.get("X-Review-Desk") != "1":', 'if False:'),
 ("origin check off", S+"server.py", 'if origin is not None and origin not in', 'if False and origin not in'),
 ("content-type check off", S+"server.py", 'if not (self.headers.get("Content-Type") or "").split(";")[0].strip().lower() == "application/json":', 'if False:'),
 ("unknown item allowed", S+"server.py", 'if p.item(item_id) is None:\n            raise HttpError(404, "unknown item")', 'pass'),
 ("unknown packet allowed (any dir)", S+"server.py", 'if entry is None:\n            raise HttpError(404, "unknown packet")', 'if entry is None:\n            from .registry import Entry\n            entry = Entry(pid, str(self.server.registry.entries()[0].path), "")'),
 ("route segments decode/loose", S+"server.py", 'SEG = r"([a-z0-9][a-z0-9-]{0,127})"', 'SEG = r"(.+?)"'),
 ("manifest traversal allowed", S+"manifest.py", 'if not p.is_relative_to(root):', 'if False:'),
 ("manifest absolute allowed", S+"manifest.py", 'if Path(rel).is_absolute() or rel.startswith("~"):', 'if False:'),
 ("raw serves by filename", S+"server.py", 'item = p.item(item_id)\n        fp = p.file_path(item) if item else None', 'item = p.item(item_id)\n        fp = p.file_path(item) if item else (p.dir / item_id)'),
 ("body cap off", S+"server.py", 'if n > MAX_BODY:', 'if False:'),
 ("raw html allowed in markdown", S+"render.py", 'MarkdownIt("commonmark", {"html": False,', 'MarkdownIt("commonmark", {"html": True,'),
 ("url filter off", S+"render.py", 'if v is not None and not safe_url(str(v)):', 'if False:'),
 ("url filter skips inline tokens", S+"render.py", 'if tok.children:\n            stack.extend(tok.children)', 'pass'),
 ("url filter not registered", S+"render.py", '_MD.core.ruler.push("url_filter", _url_filter)', 'pass'),
 ("url check skips percent-decoding", S+"render.py", 'unquote(url or "")', '(url or "")'),
 ("url check keeps control chars", S+"render.py", 'r"[\\x00-\\x20\\x7f]+", "", unquote', 'r"[\\x00-\\x08]+", "", unquote'),
 ("title not escaped", S+"render.py", '<h1>{e(packet.title)}</h1>', '<h1>{packet.title}</h1>'),
 ("merge replaces record", S+"decisions.py", 'rec = dict(state.get(item_id) or {})', 'rec = {}'),
 ("merge drops other items", S+"decisions.py", 'state = read(packet_dir)', 'state = {}'),
 ("no lock", S+"decisions.py", 'with _lock:\n        state = read(packet_dir)', 'if True:\n        import time; state = read(packet_dir); time.sleep(0.001)'),
 ("non-atomic write", S+"fsutil.py", 'os.replace(tmp, path)', 'path.write_text(open(tmp).read()[:1]); os.unlink(tmp); raise OSError("x")'),
 ("temp not cleaned", S+"fsutil.py", '        try:\n            os.unlink(tmp)', '        try:\n            pass'),
 ("cleared counts as decided", S+"summary.py", 'd = rec.get("decision") or None', 'd = rec.get("decision")'),
 ("orphans hidden", S+"summary.py", '"orphans": sorted(k for k in state if k not in ids)', '"orphans": []'),
 ("bind all interfaces", S+"server.py", 'super().__init__(("127.0.0.1", port), Handler)', 'super().__init__(("0.0.0.0", port), Handler)'),
 ("--no-browser still launches", S+"cli.py", 'if not a.no_browser:', 'if True:'),
 ("browser setting ignored", S+"cli.py", 'open_browser(url, a.browser or os.environ.get("REVIEW_DESK_BROWSER") or None)', 'open_browser(url, None)'),
 ("registry corrupt -> wipe", S+"registry.py", 'raise RegistryError(f"{self.file} is unreadable ({e}); fix or delete it by hand") from None', 'return []'),
]
base = subprocess.run(["uv","run","--offline","pytest","-q","-x"], cwd=R, capture_output=True, text=True)
assert base.returncode == 0, "baseline must be green:\n" + base.stdout[-500:]
survivors = []
for name, f, old, new in MUTANTS:
    p = R / f; orig = p.read_text()
    assert orig.count(old) == 1, f"{name}: anchor not unique/found"
    p.write_text(orig.replace(old, new))
    proc = subprocess.Popen(["uv","run","--offline","pytest","-q","-x","-p","no:cacheprovider"], cwd=R,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=120)
        failed = proc.returncode != 0
        first = next((l for l in out.splitlines() if l.startswith("FAILED")), "")
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)  # whole group: uv's pytest child must not be orphaned
        proc.wait()
        failed, first = True, "timeout"
    finally:
        p.write_text(orig)
    print(("KILLED  " if failed else "SURVIVED") + f"  {name}  {first[:110]}")
    if not failed: survivors.append(name)
print(f"{len(MUTANTS)-len(survivors)}/{len(MUTANTS)} killed; survivors: {survivors}")
raise SystemExit(1 if survivors else 0)

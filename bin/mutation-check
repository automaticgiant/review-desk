BAR = "--bar" in sys.argv
if "--only" in sys.argv:
    ONLY = sys.argv[sys.argv.index("--only") + 1]
    MUTANTS = [m for m in MUTANTS if ONLY in m[0]]
    if not MUTANTS:
        raise SystemExit(f"no mutant name contains {ONLY!r}")
def clock(sec): return f"{int(sec) // 60}:{int(sec) % 60:02}"
base = subprocess.run(["uv","run","--offline","pytest","-q","-x"], cwd=R, capture_output=True, text=True)
if base.returncode != 0:
    shutil.rmtree(_tmp, ignore_errors=True)
    raise SystemExit("baseline must be green:\n" + base.stdout[-500:])
survivors = []
t0 = time.time()
if BAR: print(f"baseline green; {len(MUTANTS)} mutants to run", flush=True)
for done, (name, f, old, new) in enumerate(MUTANTS, 1):
    p = R / f; orig = p.read_text()
    assert orig.count(old) == 1, f"{name}: anchor not unique/found"
    p.write_text(orig.replace(old, new))
    proc = subprocess.Popen(["uv","run","--offline","pytest","-q","-x","-p","no:cacheprovider"], cwd=R,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=120)
        failed = proc.returncode != 0
        first = next((l for l in out.splitlines() if l.startswith("FAILED")), "")
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)  # whole group: uv's pytest child must not be orphaned
        proc.wait()
        failed, first = True, "timeout"
    finally:
        p.write_text(orig)
    if not failed: survivors.append(name)
    if BAR:
        if not failed: print(f"SURVIVED  {name}", flush=True)
        elapsed = time.time() - t0
        fill = 30 * done // len(MUTANTS)
        print(f"[{'#' * fill}{'.' * (30 - fill)}] {done}/{len(MUTANTS)}  killed {done - len(survivors)}  survivors {len(survivors)}"
              f"  {clock(elapsed)} elapsed, ~{clock(elapsed / done * (len(MUTANTS) - done))} left", flush=True)
    else:
        print(("KILLED  " if failed else "SURVIVED") + f"  {name}  {first[:110]}", flush=True)
print(f"{len(MUTANTS)-len(survivors)}/{len(MUTANTS)} killed; survivors: {survivors}")
shutil.rmtree(_tmp, ignore_errors=True)
raise SystemExit(1 if survivors else 0)

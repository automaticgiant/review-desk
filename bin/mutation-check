#!/usr/bin/env python3
"""Mutation check: break each security/merge rule in turn and confirm the suite goes red.
Usage: bin/mutation-check   (from anywhere; needs a clean, green baseline)

Runs in a temporary copy of the repo, never in place: a desk started with --reload (or REVIEW_DESK_RELOAD=1) from this
checkout would otherwise load the mutants, and git status would show them mid-run. The copy leaves out .venv (its editable
install points back at the real source, so the mutants would never reach the tests) and is deleted afterwards."""
import atexit, os, shutil, signal, subprocess, pathlib, tempfile
SRC = pathlib.Path(__file__).resolve().parent.parent
_tmp = pathlib.Path(tempfile.mkdtemp(prefix="mutation-check-"))
atexit.register(shutil.rmtree, _tmp, True)  # also on an assertion or Ctrl-C
R = _tmp / "repo"
shutil.copytree(SRC, R, ignore=shutil.ignore_patterns(".git", ".venv", "__pycache__", ".pytest_cache"))
S = "src/review_desk/"
MUTANTS = [
 ("host check off", S+"server.py", 'if len(hosts) != 1 or hosts[0].strip() not in self._allowed_hosts():', 'if False:'),
 ("host allows any port", S+"server.py", 'return {f"127.0.0.1:{self.port}", f"localhost:{self.port}"}', 'return {f"127.0.0.1:{self.port}", f"localhost:{self.port}", "127.0.0.1", "127.0.0.1:1"}'),
 ("custom header off", S+"server.py", 'if self.headers.get("X-Review-Desk") != "1":', 'if False:'),
 ("origin check off", S+"server.py", 'if origin is not None and origin not in', 'if False and origin not in'),
 ("content-type check off", S+"server.py", 'if not (self.headers.get("Content-Type") or "").split(";")[0].strip().lower() == "application/json":', 'if False:'),
 ("unknown item allowed", S+"server.py", 'if p.item(item_id) is None:\n            raise HttpError(404, "unknown item")', 'pass'),
 ("unknown packet allowed (any dir)", S+"server.py", 'if entry is None:\n            raise HttpError(404, "unknown packet")', 'if entry is None:\n            from .registry import Entry\n            entry = Entry(pid, str(self.server.registry.entries()[0].path), "")'),
 ("route segments decode/loose", S+"server.py", 'SEG = r"([a-z0-9][a-z0-9-]{0,127})"', 'SEG = r"(.+?)"'),
 ("draft fragment serves unknown item", S+"server.py", 'if item is None:\n            raise HttpError(404, "unknown item")\n        html = render.draft_html(p, item)', 'html = render.draft_html(p, item or p.items[0])'),
 ("draft versions ignore content", S+"render.py", 'return hashlib.sha1(rendered.encode("utf-8")).hexdigest()[:12]', 'return "v"'),
 ("done packets not hidden by default", S+"static/page.css", 'body:not(.show-done) .packet.done { display: none; }', ''),
 ("done packets untagged", S+"render.py", "' done' if c['pending'] == 0 else ''", "''"),
 ("layout version ignores manifest", S+"render.py", 'return draft_version(_packet_html(pid, packet, False, ""))', 'return "v"'),
 ("layout version includes draft text", S+"render.py", 'draft_html(packet, it) if drafts else ""', 'draft_html(packet, it)'),
 ("layout header dropped", S+"server.py", '{"X-Layout-Version": render.layout_version(pid, p), "X-Static', '{"X-Static'),
 ("reviewed cards not hidden", S+"static/page.css", 'body.hide-reviewed .card:not(.just-decided)[data-decision="approve"],', 'body.hide-reviewed .card:not(.just-decided)[data-decision="x"],'),
 ("revise hidden too", S+"static/page.css", 'body.hide-reviewed .card:not(.just-decided)[data-decision="approve"],', 'body.hide-reviewed .card[data-decision="revise"],\nbody.hide-reviewed .card:not(.just-decided)[data-decision="approve"],'),
 ("manifest traversal allowed", S+"manifest.py", 'if not p.is_relative_to(root):', 'if False:'),
 ("manifest absolute allowed", S+"manifest.py", 'if Path(rel).is_absolute() or rel.startswith("~"):', 'if False:'),
 ("raw serves by filename", S+"server.py", 'item = p.item(item_id)\n        fp = p.file_path(item) if item else None', 'item = p.item(item_id)\n        fp = p.file_path(item) if item else (p.dir / item_id)'),
 ("body cap off", S+"server.py", 'if n > MAX_BODY:', 'if False:'),
 ("raw html allowed in markdown", S+"render.py", 'MarkdownIt("commonmark", {"html": False,', 'MarkdownIt("commonmark", {"html": True,'),
 ("url filter off", S+"render.py", 'if v is not None and not safe_url(str(v)):', 'if False:'),
 ("url filter skips inline tokens", S+"render.py", 'if tok.children:\n            stack.extend(tok.children)', 'pass'),
 ("url filter not registered", S+"render.py", '_MD.core.ruler.push("url_filter", _url_filter)', 'pass'),
 ("url check skips percent-decoding", S+"render.py", 'unquote(url or "")', '(url or "")'),
 ("url check keeps control chars", S+"render.py", 'r"[\\x00-\\x20\\x7f]+", "", unquote', 'r"[\\x00-\\x08]+", "", unquote'),
 ("title not escaped", S+"render.py", '<h1>{e(packet.title)}</h1>', '<h1>{packet.title}</h1>'),
 ("revise note not archived", S+"decisions.py", 'if left_revise and old.get("decision") == "revise" and', 'if False and'),
 ("editing a note archives it", S+"decisions.py", 'and not rec["note"].strip():', ':'),
 ("history not capped", S+"decisions.py", 'entries[-MAX_HISTORY:]', 'entries'),
 ("history overwrites by item", S+"decisions.py", 'history[item_id] = entries[-MAX_HISTORY:]', 'history = {item_id: entries[-MAX_HISTORY:]}'),
 ("earlier notes parsed as html", S+"static/page.js", 'li.append(t, String(en.note));', 'li.innerHTML = String(en.note); li.prepend(t);'),
 ("history route unregistered", S+"server.py", '    (re.compile(rf"^/api/p/{SEG}/history$"), "history"),\n', ''),
 ("hidden card keeps its draft open", S+"static/page.js", 'card.querySelector("details.draft").open = false;', 'void 0;'),
 ("static version header dropped", S+"server.py", ', "X-Static-Version": static_version()}', '}'),
 ("static version ignores page.js", S+"server.py", 'return f"{h(\'page.css\')}.{h(\'page.js\')}"', 'return f"{h(\'page.css\')}.0"'),
 ("old script keeps its listeners", S+"static/page.js", '{ ...opts, signal: ac.signal }', 'opts'),
 ("old script keeps polling", S+"static/page.js", 'window.__deskDispose = () => { dead = true; ac.abort(); clearInterval(poll); };', 'window.__deskDispose = () => { dead = true; ac.abort(); };'),
 ("hot swap disables fields", S+"static/page.js", 'let connected = hot;', 'let connected = false;'),
 ("js change not applied", S+"static/page.js", 'return loadScript(js);', 'staticVersion.js = js;'),
 ("ifDecision guard ignored", S+"decisions.py", 'if key in patch and (old.get(field) or "") != patch[key]:', 'if False:'),
 ("ifNote guard dropped", S+"decisions.py", '(("ifDecision", "decision"), ("ifNote", "note"))', '(("ifDecision", "decision"),)'),
 ("archive stamped with the clear time", S+"decisions.py", 'old.get("updatedAt") or rec["updatedAt"]', 'rec["updatedAt"]'),
 ("stale poll applied over a save", S+"static/page.js", 'if (dead || w !== writes) return; state = s', 'if (dead) return; state = s'),
 ("hide while typing a note", S+"static/page.js", 'if (document.activeElement === note || note.dataset.dirty) return scheduleHide(card);', ''),
 ("ifDecision stored", S+"decisions.py", 'rec.update({k: v for k, v in patch.items() if not k.startswith("if")})', 'rec.update(patch)'),
 ("conflict not a 409", S+"server.py", 'raise HttpError(409, str(e))', 'raise HttpError(400, str(e))'),
 ("deleting own note archives", S+"decisions.py", 'left_revise = "decision" in patch and rec["decision"] != "revise"', 'left_revise = True'),
 ("history written after decisions", S+"decisions.py", '            _archive(packet_dir, item_id, old["note"], old.get("updatedAt") or rec["updatedAt"])\n        state[item_id] = rec\n        atomic_write_json(path_for(packet_dir), state)\n        return rec',
  '            pass\n        state[item_id] = rec\n        atomic_write_json(path_for(packet_dir), state)\n        if left_revise and old.get("decision") == "revise" and str(old.get("note") or "").strip() and not rec["note"].strip():\n            _archive(packet_dir, item_id, old["note"], old.get("updatedAt") or rec["updatedAt"])\n        return rec'),
 ("focused field shields stale note", S+"static/page.js", '!note.dataset.dirty && note.value !== (s.note || "")', 'document.activeElement !== note && !note.dataset.dirty'),
 ("newer typing marked saved", S+"static/page.js", 'if (field.value === patch.note) delete', 'if (true) delete'),
 ("replaced script never marked dead", S+"static/page.js", 'dead = true; ac.abort();', 'ac.abort();'),
 ("hide timer trusts closure state", S+"static/page.js", 'const d = card.dataset.decision;', 'const d = state[card.dataset.id]?.decision;'),
 ("changed script reloaded every poll", S+"static/page.js", '{ staticVersion.js = js; return loadScript(js); }', '{ return loadScript(js); }'),
 ("source change not restarted", "src/review_desk/reload.py", 'if now != seen:', 'if False:'),
 ("old desk not stopped before respawn", "src/review_desk/reload.py", '                _stop(child)\n                child, crashed = spawn(), False', '                child, crashed = spawn(), False'),
 ("multi-file save restarts twice", "src/review_desk/reload.py", 'sleep(settle)  # a save that touches several files lands as one restart\n                seen = snap()', 'seen = now'),
 ("crashed desk respawn loop", "src/review_desk/reload.py", 'elif child.poll() is not None and not crashed:', 'elif child.poll() is not None:'),
 ("static files restart the desk", "src/review_desk/reload.py", 'rglob("*.py")', 'rglob("*")'),
 ("stubborn child not killed", "src/review_desk/reload.py", 'except subprocess.TimeoutExpired:\n        child.kill()', 'except subprocess.TimeoutExpired:\n        pass'),
 ("vanishing file breaks the scan", "src/review_desk/reload.py", 'except FileNotFoundError:\n            continue', 'except ZeroDivisionError:\n            continue'),
 ("reloading child reloads too", "src/review_desk/reload.py", '"serve", "--port", str(port)])', '"serve", "--port", str(port), "--reload"])'),
 ("reload env switch ignored", S+"cli.py", 'or os.environ.get("REVIEW_DESK_RELOAD") == "1"', 'or False'),
 ("background drops --reload", S+"cli.py", 'ensure_running(a.port, reload=a.reload)', 'ensure_running(a.port)'),
 ("supervisor output not flushed", "src/review_desk/reload.py", 'print(msg, flush=True)', 'print(msg)'),
 ("sigterm orphans the desk", "src/review_desk/reload.py", '        raise KeyboardInterrupt\n    signal.signal', '        return\n    signal.signal'),
 ("sigterm handler not installed", S+"cli.py", '        rl.stop_on_sigterm()\n', ''),
 ("--reload on a running desk is silent", S+"cli.py", 'if state == "desk":\n        if reload:', 'if state == "desk":\n        if False:'),
 ("merge replaces record", S+"decisions.py", 'rec = dict(old)', 'rec = {}'),
 ("merge drops other items", S+"decisions.py", 'state = read(packet_dir)', 'state = {}'),
 ("no lock", S+"decisions.py", 'with _lock:\n        state = read(packet_dir)', 'if True:\n        import time; state = read(packet_dir); time.sleep(0.001)'),
 ("non-atomic write", S+"fsutil.py", 'os.replace(tmp, path)', 'path.write_text(open(tmp).read()[:1]); os.unlink(tmp); raise OSError("x")'),
 ("temp not cleaned", S+"fsutil.py", '        try:\n            os.unlink(tmp)', '        try:\n            pass'),
 ("cleared counts as decided", S+"summary.py", 'd = rec.get("decision") or None', 'd = rec.get("decision")'),
 ("orphans hidden", S+"summary.py", '"orphans": sorted(k for k in state if k not in ids)', '"orphans": []'),
 ("bind all interfaces", S+"server.py", 'super().__init__(("127.0.0.1", port), Handler)', 'super().__init__(("0.0.0.0", port), Handler)'),
 ("--no-browser still launches", S+"cli.py", 'if not a.no_browser:', 'if True:'),
 ("browser setting ignored", S+"cli.py", 'open_browser(url, a.browser or os.environ.get("REVIEW_DESK_BROWSER") or None)', 'open_browser(url, None)'),
 ("registry corrupt -> wipe", S+"registry.py", 'raise RegistryError(f"{self.file} is unreadable ({e}); fix or delete it by hand") from None', 'return []'),
]
base = subprocess.run(["uv","run","--offline","pytest","-q","-x"], cwd=R, capture_output=True, text=True)
if base.returncode != 0:
    shutil.rmtree(_tmp, ignore_errors=True)
    raise SystemExit("baseline must be green:\n" + base.stdout[-500:])
survivors = []
for name, f, old, new in MUTANTS:
    p = R / f; orig = p.read_text()
    assert orig.count(old) == 1, f"{name}: anchor not unique/found"
    p.write_text(orig.replace(old, new))
    proc = subprocess.Popen(["uv","run","--offline","pytest","-q","-x","-p","no:cacheprovider"], cwd=R,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=120)
        failed = proc.returncode != 0
        first = next((l for l in out.splitlines() if l.startswith("FAILED")), "")
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)  # whole group: uv's pytest child must not be orphaned
        proc.wait()
        failed, first = True, "timeout"
    finally:
        p.write_text(orig)
    print(("KILLED  " if failed else "SURVIVED") + f"  {name}  {first[:110]}")
    if not failed: survivors.append(name)
print(f"{len(MUTANTS)-len(survivors)}/{len(MUTANTS)} killed; survivors: {survivors}")
shutil.rmtree(_tmp, ignore_errors=True)
raise SystemExit(1 if survivors else 0)

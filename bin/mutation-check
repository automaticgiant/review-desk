#!/usr/bin/env python3
"""Mutation check: break each security/merge rule in turn and confirm the suite goes red.
Usage: bin/mutation-check [--bar] [--only TEXT]   (from anywhere; needs a clean, green baseline)
  --bar        one progress line per mutant instead of one result line each: a bar, counts, elapsed time and an estimate of
               what is left (survivors are still named in full, at once). Fits a 10-line shell view.
  --only TEXT  run just the mutants whose name contains TEXT (a quick check of one area)

Runs in a temporary copy of the repo, never in place: a desk started with --reload (or REVIEW_DESK_RELOAD=1) from this
checkout would otherwise load the mutants, and git status would show them mid-run. The copy leaves out .venv (its editable
install points back at the real source, so the mutants would never reach the tests) and is deleted afterwards."""
import atexit, os, shutil, signal, subprocess, sys, pathlib, tempfile, time
SRC = pathlib.Path(__file__).resolve().parent.parent
_tmp = pathlib.Path(tempfile.mkdtemp(prefix="mutation-check-"))
atexit.register(shutil.rmtree, _tmp, True)  # also on an assertion or Ctrl-C
R = _tmp / "repo"
shutil.copytree(SRC, R, ignore=shutil.ignore_patterns(".git", ".venv", "__pycache__", ".pytest_cache"))
S = "src/review_desk/"

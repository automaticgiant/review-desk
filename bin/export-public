#!/bin/sh
# Export the committed tree (HEAD) as a fresh repository with one commit and no history.
# Usage: bin/export-public <dest-dir> "<Author Name>" <author-email>
# <dest-dir> must not exist. Nothing is pushed and no remote is added; uncommitted changes are not included.
set -eu
if [ $# -ne 3 ]; then
  echo "usage: $0 <dest-dir> \"<Author Name>\" <author-email>" >&2
  exit 1
fi
dest=$1 name=$2 email=$3
src="$(cd "$(dirname "$0")/.." && pwd)"
if [ -e "$dest" ]; then
  echo "export-public: $dest already exists" >&2
  exit 1
fi
mkdir -p "$dest"
git -C "$src" archive --format=tar HEAD | tar -x -C "$dest"
cd "$dest"
git init -q -b main
git add -A
GIT_AUTHOR_NAME=$name GIT_AUTHOR_EMAIL=$email GIT_COMMITTER_NAME=$name GIT_COMMITTER_EMAIL=$email \
  git -c commit.gpgsign=false commit -q -m "Initial commit"
echo "exported $(git -C "$src" rev-parse --short HEAD) to $dest as one commit by $name <$email>"
git log --format='%h %an <%ae> %s'
